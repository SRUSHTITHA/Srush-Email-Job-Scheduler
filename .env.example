# Infrastructure
DATABASE_URL="postgresql://postbox:postbox@localhost:5432/postbox?schema=public"
REDIS_URL="redis://localhost:6379"

# API and browser app
API_PORT=4000
WEB_ORIGIN="http://localhost:5173"
JWT_SECRET="replace-this-with-a-long-random-value"

# Google OAuth: create these in Google Cloud Console
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# Sending policy. Values are safe defaults for local Ethereal testing.
WORKER_CONCURRENCY=4
MIN_SEND_GAP_SECONDS=2
DEFAULT_HOURLY_LIMIT=100
